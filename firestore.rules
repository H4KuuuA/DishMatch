rules_version = '2';

// DishMatch の Firestore セキュリティルール。
service cloud.firestore {
  match /databases/{database}/documents {

    // 各ユーザーの本体データ（プロフィール／favorites／friends など）は本人のみ。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // 友達コード → uid の対応表。友達検索のためログインユーザーは読み取り可。
    // 新規作成は「まだ誰も所有していないコード」に自分の uid で登録する時だけ許可し、
    // 既存コードの上書き（update）は現所有者本人だけに限定する（＝友達コード乗っ取り防止）。
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid
                            && request.resource.data.uid == request.auth.uid;
    }

    // 友達に公開するプロフィール（ニックネーム／アイコン／好きなジャンル）。
    // ログインユーザーは誰でも読めるが、書き込みは本人のみ。
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid;
    }

    // 友達申請。当事者（送信者 fromUid・受信者 toUid）だけが読み書きできる。
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && (resource.data.fromUid == request.auth.uid
                                || resource.data.toUid == request.auth.uid);
    }

    // 友達との1対1チャット。参加者（participants）だけが読み書きできる。
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      // 参加者は他フィールド（最終メッセージ等）を更新できるが、participants 自体は
      // 変更できない（＝参加者が無関係な第三者を勝手に会話へ追加/削除するのを防止）。
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      // メッセージは、その会話の参加者だけが読める／自分名義でだけ送れる。
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // 上記以外はすべて拒否（デフォルト deny）
  }
}
